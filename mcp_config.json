{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "SuperGravity MCP Configuration for Google Antigravity",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp"],
      "description": "Framework documentation - React, Next.js, Vue, etc."
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-sequential-thinking"],
      "description": "Complex multi-step reasoning"
    },
    "magic": {
      "command": "npx",
      "args": ["-y", "@21st/magic-mcp"],
      "env": {
        "TWENTY_FIRST_API_KEY": ""
      },
      "description": "UI component generation from 21st.dev"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-playwright"],
      "description": "Browser automation and E2E testing"
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-tavily"],
      "env": {
        "TAVILY_API_KEY": ""
      },
      "description": "Web search for research"
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-firecrawl"],
      "env": {
        "FIRECRAWL_API_KEY": ""
      },
      "description": "Web scraping and content extraction"
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-postgres"],
      "env": {
        "POSTGRES_URL": ""
      },
      "description": "PostgreSQL database operations"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-filesystem"],
      "description": "File system operations"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-memory"],
      "description": "Persistent memory across sessions"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-github"],
      "env": {
        "GITHUB_TOKEN": ""
      },
      "description": "GitHub operations - PRs, issues, repos"
    }
  }
}
